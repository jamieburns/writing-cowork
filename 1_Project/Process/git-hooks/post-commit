#!/bin/sh
# =============================================================================
# writing-cowork — post-commit session-hygiene check
#
# Installed by pm-install-git-hooks. Paths below are resolved AT INSTALL TIME,
# the same compute-at-install pattern used for autoMemoryDirectory: a shipped
# template cannot carry a machine-specific absolute path.
#
# WHY A GIT HOOK, AND WHY post-commit
#   Claude Code hooks do not run in Cowork (see Decisions.md, "Hooks in
#   Cowork"). Git hooks are unrelated to those — they run wherever `git` runs,
#   on the host, and no agent runtime has any say in it. That makes this the
#   only enforcement mechanism available in every runtime.
#
#   post-commit rather than pre-commit is deliberate. The project's control
#   model is "git is the consent mechanism" and consent happens at commit, so
#   the commit is the right moment to look. A pre-commit hook that BLOCKS gets
#   --no-verify'd the first time someone is in a hurry, and a check that is
#   routinely bypassed is worse than one that always reports. This warns; it
#   never blocks. Nothing you do here can fail a commit.
#
# Set WRITING_COWORK_SKIP_HYGIENE=1 to silence it (scripted or batch commits).
# =============================================================================

[ -n "$WRITING_COWORK_SKIP_HYGIENE" ] && exit 0

DRIFT_CHECK="/Users/jburns/code/writing-cowork/0_Product/tools/drift_check.py"
CONFIG="/Users/jburns/code/writing-cowork/1_Project/Process/drift_check.yaml"
PYTHON="/opt/homebrew/bin/python3"

# Never let a missing dependency interfere with committing — but never let one
# pass unnoticed either. These three paths are absolute and resolved at install
# time, so a moved vault, a fresh clone, a different username, or a Python
# upgrade breaks them. The original version exited 0 in silence here, which made
# every one of those situations look like a clean repo forever (task c3f80b6e,
# same class as the stale autoMemoryDirectory failure this project already
# chased once). Report and continue; still never block.
_wc_unavailable() {
  printf '\n\033[31m── writing-cowork: session hygiene UNAVAILABLE ──\033[0m\n' >&2
  printf '%s\n' "$1" >&2
  printf '\033[2mPaths here are absolute and resolved at install time; a moved or\n' >&2
  printf 'cloned vault invalidates them. Re-run pm-install-git-hooks.\033[0m\n\n' >&2
  exit 0
}

[ -x "$PYTHON" ]     || _wc_unavailable "  interpreter not executable: $PYTHON"
[ -f "$DRIFT_CHECK" ] || _wc_unavailable "  drift_check.py not found: $DRIFT_CHECK"
[ -f "$CONFIG" ]     || _wc_unavailable "  drift_check.yaml not found: $CONFIG"

# --dry-run: report only. The scheduled drift check owns writing the hub's
# Attention block and the report files; this hook is a fast visible warning.
#
# 2026-07-30 (task c3f80b6e): this block used to be
#     OUT=$(... --dry-run 2>/dev/null | grep -i 'session hygiene')
# which discarded stderr and never looked at the exit code. When drift_check.py
# could not run at all — the real case that found this: PyYAML missing, so it
# wrote to stderr and exited 2 — $OUT came back empty and the hook printed
# nothing. A broken checker was indistinguishable from a clean repo. The whole
# point of v0.1.17 is enforcement that works in every runtime, so a checker
# that fails quietly is worse than no checker: it manufactures false
# confidence. Failure is now louder than success.

ERRF=$(mktemp 2>/dev/null || echo "/tmp/writing-cowork-hygiene.$$")
OUT=$("$PYTHON" "$DRIFT_CHECK" --config "$CONFIG" --dry-run 2>"$ERRF")
RC=$?

if [ "$RC" -ne 0 ]; then
  printf '\n\033[31m── writing-cowork: session hygiene UNAVAILABLE ──\033[0m\n' >&2
  printf 'The check could not run (exit %s). Your commit landed fine.\n' "$RC" >&2
  [ -s "$ERRF" ] && sed 's/^/  /' "$ERRF" >&2
  printf '\033[2mThis is reported rather than swallowed on purpose: silence here\n' >&2
  printf 'would look exactly like "nothing to report".\033[0m\n\n' >&2
  rm -f "$ERRF"
  exit 0
fi
rm -f "$ERRF"

HITS=$(printf '%s\n' "$OUT" | grep -i 'session hygiene')

if [ -n "$HITS" ]; then
  printf '\n\033[33m── writing-cowork: session hygiene ──\033[0m\n' >&2
  printf '%s\n' "$HITS" >&2
  printf '\033[2mRun pm-close-session to promote, log, and clear these.\033[0m\n\n' >&2
fi

exit 0
